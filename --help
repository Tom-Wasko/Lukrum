    zoomWokol((a[0] + b[0]) / 2, (a[1] + b[1]) / 2, d / szczyp.d); szczyp.d = d;
  } else { W.cx -= (sx - px) / W.k; W.cy -= (sy - py) / W.k; rysujWidok(); }
});
const koniecTla = (e) => { wskazniki.delete(e.pointerId); if (wskazniki.size < 2) szczyp = null; if (!wskazniki.size) svg.classList.remove("chwyt"); };
svg.addEventListener("pointerup", (e) => { if (ciag && ciag.pid === e.pointerId) return skonczPrzeciaganie(e); koniecTla(e); });
svg.addEventListener("pointercancel", (e) => { if (ciag && ciag.pid === e.pointerId) return skonczPrzeciaganie(e, true); koniecTla(e); });
svg.addEventListener("wheel", (e) => { e.preventDefault(); const [sx, sy] = pozycjaEkran(e); zoomWokol(sx, sy, Math.exp(-e.deltaY * 0.0016)); }, { passive: false });

function zacznijPrzeciaganie(e, id) {
  if (e.button > 0) return;
  e.stopPropagation(); e.preventDefault();
  try { svg.setPointerCapture(e.pointerId); } catch (_) { /* wskaźnik syntetyczny */ }
  const [sx, sy] = pozycjaEkran(e), [x, y] = naXY(poz[id].lat, poz[id].lon), [ex, ey] = doEkranu(x, y);
  ciag = { id, pid: e.pointerId, start: [sx, sy], dx: ex - sx, dy: ey - sy, ruszony: false, przed: { ...poz[id] } };
}
function przeciagaj(e) {
  const [sx, sy] = pozycjaEkran(e);
  if (!ciag.ruszony && Math.hypot(sx - ciag.start[0], sy - ciag.start[1]) < 5) return;
  ciag.ruszony = true;
  const [x, y] = doSwiata(sx + ciag.dx, sy + ciag.dy);
  poz[ciag.id] = naGeo(x, y);
  ustawZetony();
}
async function skonczPrzeciaganie(e, anuluj = false) {
  const c = ciag; ciag = null;
  try { svg.releasePointerCapture(e.pointerId); } catch (_) { /* już zwolniony */ }
  if (!c.ruszony || anuluj) { poz[c.id] = c.przed; ustawZetony(); if (!anuluj) wybierz(c.id, false); return; }
  const z = POR.get(c.id);
  if (z.zablokowany && !zgoda.has(c.id)) {
    const ok = await dialog({
      tytul: "<span class=\"ostrz\">&#9888;</span> Przenieść zablokowany żeton?",
      tresc: `Ten budynek ma realny adres: <b>${esc(z.adres || "(brak adresu)")}</b>.<br>„${esc(z.nazwa)}” stoi w prawdziwym miejscu Lublina. Przenieść go mimo to?`,
      tak: "Przenieś mimo to", nie: "Zostaw na miejscu", niebezp: true });
    if (!ok) { poz[c.id] = c.przed; ustawZetony(); return; }
    zgoda.add(c.id);
  }
  zatwierdzZmiane(c.id, c.przed);
}
function zatwierdzZmiane(id, przed) {
  const teraz = poz[id]; poz[id] = przed; migawka(); poz[id] = teraz;
  anulujPodglad(true); wybierz(id, false); odswiez();
}

/* ---------- historia ---------- */
function migawka() { cofnij.push(JSON.stringify(poz)); if (cofnij.length > 200) cofnij.shift(); ponow = []; }
function wstecz() { if (!cofnij.length) return; ponow.push(JSON.stringify(poz)); poz = JSON.parse(cofnij.pop()); anulujPodglad(true); odswiez(); }
function naprzod() { if (!ponow.length) return; cofnij.push(JSON.stringify(poz)); poz = JSON.parse(ponow.pop()); anulujPodglad(true); odswiez(); }
$("cofnij").onclick = wstecz; $("ponow").onclick = naprzod;
$("oryginal").onclick = async () => {
  if (!ilePrzesunietych()) return;
  const ok = await dialog({ tytul: "Przywrócić oryginał?", tresc: `Wszystkie przesunięcia (${ilePrzesunietych()}) wrócą na pierwotne miejsca. Można to cofnąć przyciskiem „Cofnij”.`, tak: "Przywróć oryginał", nie: "Anuluj", niebezp: true });
  if (!ok) return;
  migawka(); poz = JSON.parse(JSON.stringify(ORIG)); anulujPodglad(true); odswiez();
};

/* ---------- lista, wyszukiwarka, filtr ---------- */
const szukaj = $("szukaj"), filtr = $("filtr");
const rodzaje = [...new Set(Z.map((z) => z.rodzaj))].sort((a, b) => rodzajNazwa(a).localeCompare(rodzajNazwa(b), "pl"));
filtr.innerHTML = `<option value="">Wszystkie rodzaje (${Z.length})</option><option value="@zablokowane">Zablokowane – realny adres (${Z.filter((z) => z.zablokowany).length})</option><option value="@swobodne">Swobodne (${Z.filter((z) => !z.zablokowany).length})</option><option value="@przesuniete">Przesunięte</option>`
  + rodzaje.map((r) => `<option value="${r}">${esc(rodzajNazwa(r))} (${Z.filter((z) => z.rodzaj === r).length})</option>`).join("");
const bezOgonkow = (s) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/ł/g, "l");
function przelicz() {
  const q = bezOgonkow(szukaj.value.trim()), f = filtr.value;
  trafione = new Set(Z.filter((z) =>
    (!q || bezOgonkow(z.nazwa + " " + z.id + " " + (z.adres || "")).includes(q)) &&
    (!f || (f === "@zablokowane" ? z.zablokowany : f === "@swobodne" ? !z.zablokowany : f === "@przesuniete" ? przesuniety(z.id) : z.rodzaj === f))).map((z) => z.id));
  if (!q && !f) trafione = null;
}
function rysujListe() {
  const ul = $("lista"); ul.replaceChildren();
  const ikona = (z) => z.zablokowany
    ? `<svg class="ikona" viewBox="-10 -10 20 20" aria-hidden="true"><rect x="-8" y="-8" width="16" height="16" rx="3.5" fill="var(--tusz)"/><rect x="-4" y="-.5" width="8" height="6" rx="1" fill="var(--papier)"/><path d="M-2.3 -.5V-2.5a2.3 2.3 0 0 1 4.6 0V-.5" fill="none" stroke="var(--papier)" stroke-width="1.5"/></svg>`
    : `<svg class="ikona" viewBox="-10 -10 20 20" aria-hidden="true"><circle r="7.5" fill="var(--akcent-2)" stroke="var(--tusz)" stroke-width="2"/></svg>`;
  const lista = Z.filter((z) => !trafione || trafione.has(z.id)).sort((a, b) => a.nazwa.localeCompare(b.nazwa, "pl"));
  for (const z of lista) {
    const li = document.createElement("li"); if (z.id === wybrany) li.className = "wybrany";
    li.innerHTML = `<button type="button" data-id="${z.id}">${ikona(z)}<span class="nazwa">${esc(z.nazwa)}<br><span class="rodzaj">${esc(rodzajNazwa(z.rodzaj))}</span></span>${z.zablokowany ? '<span class="znaczek">kłódka</span>' : ""}${przesuniety(z.id) ? '<span class="znaczek przes">Δ przesunięty</span>' : ""}</button>`;
    ul.appendChild(li);
  }
  if (!lista.length) ul.innerHTML = "<li style=\"padding:10px\">Brak żetonów pasujących do wyszukiwania.</li>";
}
$("lista").addEventListener("click", (e) => { const b = e.target.closest("button[data-id]"); if (b) wybierz(b.dataset.id, true); });
szukaj.addEventListener("input", odswiez); filtr.addEventListener("change", odswiez);

function wybierz(id, przesun) {
  wybrany = id;
  if (przesun) {
    const [x, y] = naXY(poz[id].lat, poz[id].lon);
    if (W.k < 0.3) W.k = 0.3;
    W.cx = x; W.cy = y;
  }
  odswiez(); rysujWidok();
}
function rysujWybor() {
  const b = $("wybor");
  if (!wybrany) { b.hidden = true; return; }
  const z = POR.get(wybrany), p = poz[wybrany], o = ORIG[wybrany];
  b.hidden = false;
  b.innerHTML = `<b>${esc(z.nazwa)}</b><span>${esc(rodzajNazwa(z.rodzaj))} · ${z.zablokowany ? "zablokowany (kłódka)" : "swobodny"}${z.adres ? " · " + esc(z.adres) : ""}</span>
    <span>Położenie: ${p.lat}, ${p.lon}</span>${przesuniety(wybrany) ? `<span>Oryginał: ${o.lat}, ${o.lon}</span><button class="przycisk" id="przywroc-jeden">Przywróć ten żeton</button>` : ""}`;
  const bt = $("przywroc-jeden");
  if (bt) bt.onclick = () => { migawka(); poz[wybrany] = { ...ORIG[wybrany] }; anulujPodglad(true); odswiez(); };
}
function odswiez() {
  przelicz(); rysujListe(); rysujWybor(); ustawZetony();
  const n = ilePrzesunietych();
  $("licznik").textContent = "Przesunięto: " + n;
  $("cofnij").disabled = !cofnij.length; $("ponow").disabled = !ponow.length; $("oryginal").disabled = !n;
  if ($("kopiuj-box").classList.contains("pokaz")) pokazKopie(false);
}

/* ---------- rozproszenie ---------- */
function proponujRozproszenie(D) {
  const MAKS = 700;   // m: o tyle najdalej wolno przesunąć żeton od oryginału
  const pt = {};
  for (const z of Z) { const [x, y] = naXY(poz[z.id].lat, poz[z.id].lon); const [x0, y0] = naXY(ORIG[z.id].lat, ORIG[z.id].lon); pt[z.id] = { x, y, x0, y0, dz: dzielnicaXY(x, y), z }; }
  const wolne = Z.filter((z) => !z.zablokowany).map((z) => pt[z.id]);
  const stale = Z.filter((z) => z.zablokowany).map((z) => pt[z.id]);
  const pary = () => { let n = 0; const wszystkie = [...wolne, ...stale]; for (let i = 0; i < wszystkie.length; i++) for (let j = i + 1; j < wszystkie.length; j++) { const a = wszystkie[i], b = wszystkie[j]; if (a.dz === b.dz && (!a.z.zablokowany || !b.z.zablokowany) && Math.hypot(a.x - b.x, a.y - b.y) < D) n++; } return n; };
  const przed = pary();
  const wewnatrz = (p, x, y) => p.dz < 0 || kanwa.isPointInPath(SCIEZKI[p.dz], x, y);
  for (let it = 0; it < 120; it++) {
    let ruch = 0;
    const dx = new Map(wolne.map((p) => [p, [0, 0]]));
    for (let i = 0; i < wolne.length; i++) {
      const a = wolne[i];
      const sasiedzi = [...wolne.slice(i + 1), ...stale];
      for (const b of sasiedzi) {
        if (a.dz !== b.dz) continue;
        let vx = a.x - b.x, vy = a.y - b.y, d = Math.hypot(vx, vy);
        if (d >= D) continue;
        if (d < 0.5) { const kat = (i * 2.399963 + sasiedzi.indexOf(b)) % (2 * Math.PI); vx = Math.cos(kat); vy = Math.sin(kat); d = 1; }
        const u = (D - d) / d, ba = b.z.zablokowany ? 1 : 0.5;
        dx.get(a)[0] += vx * u * ba; dx.get(a)[1] += vy * u * ba;
        if (!b.z.zablokowany) { dx.get(b)[0] -= vx * u * 0.5; dx.get(b)[1] -= vy * u * 0.5; }
      }
    }
    for (const p of wolne) {
      let [sx, sy] = dx.get(p); sx *= 0.6; sy *= 0.6;
      for (let t = 0; t < 4; t++) {
        let nx = p.x + sx, ny = p.y + sy;
        const o = Math.hypot(nx - p.x0, ny - p.y0);
        if (o > MAKS) { nx = p.x0 + (nx - p.x0) * MAKS / o; ny = p.y0 + (ny - p.y0) * MAKS / o; }
        if (wewnatrz(p, nx, ny)) { ruch += Math.hypot(nx - p.x, ny - p.y); p.x = nx; p.y = ny; break; }
        sx /= 2; sy /= 2;
      }
    }
    if (ruch < 0.5) break;
  }
  const po = pary();
  const wynik = {};
  for (const p of wolne) { const g = naGeo(p.x, p.y); if (g.lat !== poz[p.z.id].lat || g.lon !== poz[p.z.id].lon) wynik[p.z.id] = g; }
  return { wynik, przed, po };
}
function pokazPodglad() {
  const D = Math.max(30, Math.min(600, +$("odleglosc").value || 170));
  const { wynik, przed, po } = proponujRozproszenie(D);
  podglad = wynik;
  const n = Object.keys(wynik).length;
  $("podglad-opis").innerHTML = n
    ? `Do przesunięcia: <b>${n}</b> swobodnych żetonów (zielone przerywane kółka). Pary bliżej niż ${D} m: <b>${przed} → ${po}</b>. Zablokowane (kłódka) zostają w miejscu.`
    : `Nic do rozsunięcia: swobodne żetony są już dalej od siebie niż ${D} m (pary bliżej: ${przed}).`;
  $("podglad-ok").disabled = !n;
  $("podglad").classList.add("pokaz");
  rysujDuchy();
}
function anulujPodglad(cicho) { podglad = null; $("podglad").classList.remove("pokaz"); if (!cicho) rysujDuchy(); else warDuchy.replaceChildren(); }
$("rozprosz").onclick = pokazPodglad;
$("odleglosc").onchange = pokazPodglad;
$("podglad-nie").onclick = () => anulujPodglad(false);
$("podglad-ok").onclick = () => { if (!podglad) return; migawka(); for (const id in podglad) poz[id] = podglad[id]; anulujPodglad(true); odswiez(); };

/* ---------- kopiowanie zmian ---------- */
function zmiany() { const w = {}; for (const z of Z) if (przesuniety(z.id)) w[z.id] = { lat: poz[z.id].lat, lon: poz[z.id].lon }; return w; }
function pokazKopie(proba) {
  const tekst = JSON.stringify(zmiany(), null, 2), box = $("kopiuj-box"), ta = $("kopiuj-tekst");
  ta.value = tekst; box.classList.add("pokaz");
  const stan = $("kopiuj-stan");
  if (!proba) return;
  const n = ilePrzesunietych();
  if (!n) { stan.textContent = "Nic nie przesunięto, więc nie ma czego kopiować."; return; }
  const zapas = () => { ta.focus(); ta.select(); stan.textContent = "Schowek niedostępny: tekst jest zaznaczony, skopiuj go ręcznie (Ctrl+C)."; };
  try {
    navigator.clipboard.writeText(tekst).then(() => { stan.textContent = `Skopiowano do schowka (${n} przesuniętych).`; }, zapas);
  } catch (_) { zapas(); }
}
$("kopiuj").onclick = () => pokazKopie(true);
$("kopiuj-zamknij").onclick = () => $("kopiuj-box").classList.remove("pokaz");
$("kopiuj-zaznacz").onclick = () => { $("kopiuj-tekst").focus(); $("kopiuj-tekst").select(); };

/* ---------- start ---------- */
$("zoom-plus").onclick = () => zoomWokol(W.w / 2, W.h / 2, 1.6);
$("zoom-minus").onclick = () => zoomWokol(W.w / 2, W.h / 2, 1 / 1.6);
$("zoom-caly").onclick = calaMapa;
new ResizeObserver(() => { rozmiar(); rysujWidok(); }).observe($("skrzynka"));
rozmiar(); calaMapa(); odswiez();
</script>
</body>
