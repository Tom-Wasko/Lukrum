<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LUKRUM – edytor rozmieszczenia żetonów na mapie Lublina</title>
<style>
/* Kolory z panel_gracza/static/motywy/zmienne.css: paleta „Bar mleczny” (jasny, a przy ciemnym systemie ciemny). */
:root {
  --papier: #e9ede3; --tusz: #1d2721; --akcent: #c2302a; --akcent-2: #2f6f8f; --ramka: #8d978c;
  --zysk: #2e6b3a; --strata: #b3261e; --uwaga: #8a5a00;
  --font-tekst: 'PT Sans', 'Segoe UI', system-ui, sans-serif;
  --font-szyld: 'Oswald', 'Arial Narrow', 'Segoe UI', sans-serif;
  --ognisko: 3px solid var(--akcent-2);
  --karta: color-mix(in srgb, var(--papier) 45%, #fff);
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root {
    --papier: #121815; --tusz: #e5ebe2; --akcent: #ff5a4e; --akcent-2: #62c3e6; --ramka: #3d4a43;
    --zysk: #7fd18b; --strata: #ff7a70; --uwaga: #f2c14e;
    --karta: color-mix(in srgb, var(--papier) 86%, #fff);
    color-scheme: dark;
  }
}
* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; }
body { background: var(--papier); color: var(--tusz); font: 15px/1.35 var(--font-tekst); display: flex; flex-direction: column; }
button, input, select, textarea { font: inherit; color: inherit; }
:focus-visible { outline: var(--ognisko); outline-offset: 2px; }
header { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 8px 12px; border-bottom: 2px solid var(--tusz); background: var(--karta); }
h1 { margin: 0; font: 600 20px var(--font-szyld); letter-spacing: .04em; text-transform: uppercase; }
h1 small { font: 13px var(--font-tekst); text-transform: none; letter-spacing: 0; opacity: .8; margin-left: 6px; }
.pasek { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.przycisk { border: 2px solid var(--tusz); background: var(--karta); border-radius: 6px; padding: 5px 11px; cursor: pointer; min-height: 36px; }
.przycisk:hover:not(:disabled) { background: color-mix(in srgb, var(--karta) 80%, var(--akcent-2)); }
.przycisk:disabled { opacity: .45; cursor: not-allowed; border-style: dashed; }
.przycisk.glowny { background: var(--akcent-2); color: var(--papier); font-weight: 700; }
.przycisk.glowny:hover:not(:disabled) { background: color-mix(in srgb, var(--akcent-2) 80%, var(--tusz)); }
.licznik { font-weight: 700; padding: 4px 8px; border: 2px dashed var(--akcent); border-radius: 6px; }
main { flex: 1; min-height: 0; display: grid; grid-template-columns: 340px 1fr; }
aside { border-right: 2px solid var(--tusz); display: flex; flex-direction: column; min-height: 0; background: var(--karta); }
.szukaj { padding: 8px; display: grid; gap: 6px; border-bottom: 1px solid var(--ramka); }
.szukaj input, .szukaj select { width: 100%; padding: 6px 8px; border: 2px solid var(--ramka); border-radius: 6px; background: var(--papier); min-height: 36px; }
.legenda { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 13px; padding: 6px 8px; border-bottom: 1px solid var(--ramka); }
.legenda span { display: inline-flex; align-items: center; gap: 5px; }
.lista { list-style: none; margin: 0; padding: 0; overflow: auto; flex: 1; min-height: 0; }
.lista li { border-bottom: 1px solid color-mix(in srgb, var(--ramka) 50%, transparent); }
.lista button { all: unset; box-sizing: border-box; display: flex; gap: 8px; align-items: center; width: 100%; padding: 6px 10px; cursor: pointer; }
.lista button:hover { background: color-mix(in srgb, var(--karta) 75%, var(--akcent-2)); }
.lista button:focus-visible { outline: var(--ognisko); outline-offset: -3px; }
.lista li.wybrany button { background: color-mix(in srgb, var(--karta) 60%, var(--akcent-2)); font-weight: 700; }
.lista .nazwa { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lista .rodzaj { font-size: 12px; opacity: .75; }
.znaczek { font-size: 11px; font-weight: 700; padding: 0 5px; border-radius: 4px; border: 1.5px solid currentColor; white-space: nowrap; }
.znaczek.przes { color: var(--akcent); }
.ikona { flex: none; width: 18px; height: 18px; }
.karta-wybor { padding: 8px 10px; border-top: 2px solid var(--tusz); font-size: 14px; display: grid; gap: 3px; }
.karta-wybor b { font-size: 16px; }
.karta-wybor .przycisk { justify-self: start; margin-top: 4px; }
.mapa-box { position: relative; min-width: 0; min-height: 0; overflow: hidden; background: var(--papier); touch-action: none; }
svg#mapa { width: 100%; height: 100%; display: block; cursor: grab; user-select: none; -webkit-user-select: none; touch-action: none; }
svg#mapa.chwyt { cursor: grabbing; }
.m-miasto { fill: color-mix(in srgb, var(--papier) 88%, var(--ramka)); }
.m-dzielnica { fill: none; stroke: var(--ramka); stroke-width: 1; vector-effect: non-scaling-stroke; stroke-dasharray: 5 3; }
.m-woda { fill: color-mix(in srgb, var(--akcent-2) 38%, var(--papier)); stroke: color-mix(in srgb, var(--akcent-2) 70%, var(--tusz)); stroke-width: 1; vector-effect: non-scaling-stroke; }
.m-rzeka { fill: none; stroke: color-mix(in srgb, var(--akcent-2) 60%, var(--papier)); stroke-width: 2.5; vector-effect: non-scaling-stroke; stroke-linecap: round; }
.m-zielen { fill: color-mix(in srgb, var(--zysk) 20%, var(--papier)); stroke: none; }
.m-droga { fill: none; stroke: color-mix(in srgb, var(--tusz) 45%, var(--papier)); vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
.m-droga.ekspresowa { stroke-width: 3.2; stroke: color-mix(in srgb, var(--tusz) 70%, var(--papier)); }
.m-droga.glowna { stroke-width: 2.2; }
.m-droga.zbiorcza { stroke-width: 1.4; }
.m-droga.lokalna { stroke-width: .7; opacity: .7; }
.napis-dz { font: 600 12px var(--font-szyld); letter-spacing: .06em; text-transform: uppercase; fill: color-mix(in srgb, var(--tusz) 65%, var(--papier)); text-anchor: middle; pointer-events: none; paint-order: stroke; stroke: var(--papier); stroke-width: 3px; }
.zeton { cursor: grab; }
.zeton:active { cursor: grabbing; }
.zeton .trafienie { fill: transparent; }
.zeton .korpus { fill: var(--akcent-2); stroke: var(--tusz); stroke-width: 2; }
.zeton.zablokowany .korpus { fill: var(--tusz); stroke: var(--papier); }
.zeton .klodka { fill: var(--papier); stroke: var(--papier); }
.zeton .klodka-lacznik { fill: none; stroke: var(--papier); stroke-width: 1.6; }
.zeton .pierscien { display: none; fill: none; stroke: var(--akcent); stroke-width: 3; stroke-dasharray: 3 2.5; }
.zeton.przesuniety .pierscien { display: inline; }
.zeton .delta { display: none; font: 700 11px var(--font-tekst); fill: var(--akcent); paint-order: stroke; stroke: var(--papier); stroke-width: 3px; }
.zeton.przesuniety .delta { display: inline; }
.zeton.wybrany .korpus { stroke: var(--akcent); stroke-width: 3.5; }
.zeton.przygaszony { opacity: .22; }
.zeton.trafiony .korpus { stroke: var(--akcent); stroke-width: 3.5; }
.etykieta { font: 700 12px var(--font-tekst); fill: var(--tusz); paint-order: stroke; stroke: var(--papier); stroke-width: 4px; pointer-events: none; }
.duch .korpus { fill: none; stroke: var(--zysk); stroke-width: 2.5; stroke-dasharray: 4 3; }
.duch-linia { stroke: var(--zysk); stroke-width: 2; stroke-dasharray: 5 3; }
.zoom { position: absolute; right: 10px; top: 10px; display: grid; gap: 6px; }
.zoom .przycisk { width: 42px; height: 42px; font-size: 20px; padding: 0; font-weight: 700; }
.podglad { position: absolute; left: 10px; right: 64px; bottom: 10px; max-width: 560px; background: var(--karta); border: 2px solid var(--zysk); border-radius: 8px; padding: 10px 12px; display: none; gap: 8px; box-shadow: 0 2px 10px rgba(0,0,0,.25); }
.podglad.pokaz { display: grid; }
.podglad h2 { margin: 0; font: 600 16px var(--font-szyld); text-transform: uppercase; letter-spacing: .04em; }
.podglad label { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.podglad input[type=number] { width: 80px; padding: 3px 6px; border: 2px solid var(--ramka); border-radius: 6px; background: var(--papier); }
.kopiuj-box { position: absolute; left: 10px; top: 10px; width: min(420px, calc(100% - 80px)); background: var(--karta); border: 2px solid var(--tusz); border-radius: 8px; padding: 10px 12px; display: none; gap: 6px; box-shadow: 0 2px 10px rgba(0,0,0,.25); }
.kopiuj-box.pokaz { display: grid; }
.kopiuj-box textarea { width: 100%; height: 150px; font: 12px/1.35 Consolas, monospace; background: var(--papier); border: 2px solid var(--ramka); border-radius: 6px; padding: 6px; resize: vertical; }
.kopiuj-box .stan { font-weight: 700; }
.tlo-dialog { position: fixed; inset: 0; background: rgba(10,14,12,.55); display: none; align-items: center; justify-content: center; z-index: 50; padding: 12px; }
.tlo-dialog.pokaz { display: flex; }
.dialog { background: var(--karta); color: var(--tusz); border: 3px solid var(--tusz); border-radius: 10px; max-width: 460px; width: 100%; padding: 16px 18px; box-shadow: 0 6px 24px rgba(0,0,0,.4); }
.dialog h2 { margin: 0 0 8px; font: 600 19px var(--font-szyld); text-transform: uppercase; letter-spacing: .04em; display: flex; gap: 8px; align-items: center; }
.dialog p { margin: 0 0 14px; }
.dialog .przyciski { display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap; }
.dialog .ostrz { color: var(--uwaga); font-weight: 700; }
.dialog .przycisk.niebezp { background: var(--akcent); color: var(--papier); border-color: var(--tusz); font-weight: 700; }
.sr { position: absolute; left: -9999px; }
@media (max-width: 760px) {
  main { grid-template-columns: 1fr; grid-template-rows: 1fr 42%; }
  aside { order: 2; border-right: 0; border-top: 2px solid var(--tusz); }
  .mapa-box { order: 1; }
  h1 small { display: none; }
}
</style>
</head>
<body>
<header>
  <h1>LUKRUM <small>edytor rozmieszczenia żetonów</small></h1>
  <div class="pasek" role="toolbar" aria-label="Działania">
    <button class="przycisk" id="cofnij" disabled title="Ctrl+Z">Cofnij</button>
    <button class="przycisk" id="ponow" disabled title="Ctrl+Y">Ponów</button>
    <button class="przycisk" id="oryginal" disabled>Przywróć oryginał</button>
    <button class="przycisk" id="rozprosz">Zaproponuj bardziej rozproszone ustawienie</button>
    <button class="przycisk glowny" id="kopiuj">Kopiuj zmiany</button>
    <span class="licznik" id="licznik" aria-live="polite">Przesunięto: 0</span>
  </div>
</header>
<main>
  <aside>
    <div class="szukaj">
      <input type="search" id="szukaj" placeholder="Szukaj po nazwie…" aria-label="Szukaj żetonu po nazwie" autocomplete="off">
      <select id="filtr" aria-label="Filtr po rodzaju"></select>
    </div>
    <div class="legenda" aria-label="Legenda">
      <span><svg class="ikona" viewBox="-10 -10 20 20"><circle r="7" fill="var(--akcent-2)" stroke="var(--tusz)" stroke-width="2"/></svg> swobodny</span>
      <span><svg class="ikona" viewBox="-10 -10 20 20"><rect x="-7" y="-7" width="14" height="14" rx="3" fill="var(--tusz)"/><rect x="-3.5" y="-.5" width="7" height="5" rx="1" fill="var(--papier)"/><path d="M-2 -.5V-2.5a2 2 0 0 1 4 0V-.5" fill="none" stroke="var(--papier)" stroke-width="1.4"/></svg> kłódka: realny adres</span>
      <span><svg class="ikona" viewBox="-10 -10 20 20"><circle r="8" fill="none" stroke="var(--akcent)" stroke-width="2.5" stroke-dasharray="3 2.5"/><circle r="4" fill="var(--akcent-2)"/></svg> przesunięty (Δ)</span>
    </div>
    <ul class="lista" id="lista"></ul>
    <div class="karta-wybor" id="wybor" hidden></div>
  </aside>
  <div class="mapa-box" id="skrzynka">
    <svg id="mapa" role="application" aria-label="Mapa Lublina z żetonami budynków">
      <g id="swiat"></g>
      <g id="napisy"></g>
      <g id="duchy"></g>
      <g id="zetony"></g>
    </svg>
    <div class="zoom">
      <button class="przycisk" id="zoom-plus" aria-label="Przybliż">+</button>
      <button class="przycisk" id="zoom-minus" aria-label="Oddal">−</button>
      <button class="przycisk" id="zoom-caly" aria-label="Pokaż całe miasto" title="Całe miasto">⌂</button>
    </div>
    <div class="podglad" id="podglad" role="region" aria-label="Podgląd rozproszenia">
      <h2>Podgląd: rozproszone ustawienie</h2>
      <label>Najmniejsza odległość swobodnych żetonów (m): <input type="number" id="odleglosc" value="170" min="30" max="600" step="10"></label>
      <div id="podglad-opis"></div>
      <div class="pasek">
        <button class="przycisk glowny" id="podglad-ok">Zatwierdź</button>
        <button class="przycisk" id="podglad-nie">Odrzuć</button>
      </div>
    </div>
    <div class="kopiuj-box" id="kopiuj-box" role="region" aria-label="Zmiany do skopiowania">
      <div class="stan" id="kopiuj-stan" aria-live="polite"></div>
      <textarea id="kopiuj-tekst" readonly aria-label="Zmiany w formacie JSON"></textarea>
      <div class="pasek"><button class="przycisk" id="kopiuj-zaznacz">Zaznacz tekst</button><button class="przycisk" id="kopiuj-zamknij">Zamknij</button></div>
    </div>
  </div>
</main>
<div class="tlo-dialog" id="tlo-dialog"><div class="dialog" id="dialog" role="dialog" aria-modal="true" aria-labelledby="dialog-tytul"></div></div>
